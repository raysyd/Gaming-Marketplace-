# --- Supabase (auth, listings, messaging) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe Connect (payments + escrow) ---
# No publishable key needed — every Stripe flow here (Checkout, Connect
# onboarding, the Billing Portal, Identity verification) redirects to a
# Stripe-hosted page rather than using Stripe.js/Elements in the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Your cut of each sale, in basis points. 800 = 8%.
PLATFORM_FEE_BPS=800

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Transactional email (order confirmations, sale notifications) ---
# Point this at the same provider/account you set up under "Production
# magic-link email" in the README — Supabase Auth's own SMTP settings live
# in the Supabase dashboard and aren't reachable from this app's code, so
# the credentials need to be repeated here to send from application code.
# Left blank, order emails just log a warning instead of sending — nothing
# else breaks.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Auto-release cron (see vercel.json) ---
# Any random string. Vercel sends it back as `Authorization: Bearer <value>`
# on scheduled invocations automatically once this is set as a project env
# var — you don't wire that up yourself. Hourly cron schedules need a Vercel
# Pro plan; Hobby is limited to once/day, which still auto-releases orders,
# just up to ~24h later than the 48h deadline instead of ~1h later.
CRON_SECRET=
